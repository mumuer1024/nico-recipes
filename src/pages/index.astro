---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout singleScreen>
	<section class="hero shell">
		<div class="hero-copy">
			<div class="hero-kicker">NICO'S KITCHEN NOTEBOOK <span>·</span> 2026</div>
			<h1>今天，<br><em>吃点什么？</em></h1>
			<p>猫猫餐桌、高蛋白食谱，<br>还有一本来自 1910 年的美国烹饪书。<br><span>认真挑一道，或者交给运气。</span></p>
			<div class="actions"><a class="button" href={`${base}recipes/`}>浏览菜谱 <span aria-hidden="true">→</span></a><a class="random-link" href={`${base}gacha/`}>随便抽一个 <span aria-hidden="true">↗</span></a></div>
		</div>
		<a class="recipe-balls" href={`${base}gacha/`} aria-label="进入扭蛋机，随便抽一道菜谱">
			<span class="ball ball-one"></span><span class="ball ball-two"></span><span class="ball ball-three"></span><span class="ball ball-four"></span><span class="ball ball-five"></span>
		</a>
	</section>
</Layout>
<style>
	.hero { display:grid; grid-template-columns:1.3fr 1fr; align-items:center; gap:24px; padding:clamp(24px, 5vh, 64px) 0; }
	.hero-copy { position:relative; z-index:1; }
	.hero-kicker { color:var(--orange); font-size:.74rem; letter-spacing:.12em; }
	h1 { margin:22px 0 18px; color:var(--moss); font-size:clamp(3.2rem, 7.5vw, 6.2rem); line-height:1.06; letter-spacing:-.08em; font-weight:800; }
	h1 em { color:var(--ink); font-style:normal; }
	p { color:var(--muted); margin:0 0 28px; font-size:.95rem; line-height:1.82; }
	p span { display:inline-block; margin-top:12px; }
	.actions { display:flex; align-items:center; gap:24px; flex-wrap:wrap; }
	.button { display:inline-flex; gap:30px; align-items:center; padding:12px 20px; color:#fff; background:var(--moss); border-radius:2px; text-decoration:none; font-size:.9rem; transition:background .2s; }
	.button:hover { background:var(--ink); }
	.random-link { display:inline-flex; align-items:center; min-height:44px; gap:10px; color:var(--moss); text-decoration:none; font-size:.9rem; }
	.random-link span { color:var(--orange); }
	.recipe-balls { display:block; position:relative; width:100%; aspect-ratio:1; max-height:430px; }
	.ball { position:absolute; border-radius:50%; }
	.ball-one { width:48%; aspect-ratio:1; background:var(--moss); left:5%; top:25%; animation:float 9s ease-in-out infinite alternate; }
	.ball-two { width:34%; aspect-ratio:1; background:var(--orange); right:3%; top:9%; animation:float 12s ease-in-out -4s infinite alternate-reverse; }
	.ball-three { width:25%; aspect-ratio:1; background:var(--line); right:9%; bottom:12%; }
	.ball-four { width:13%; aspect-ratio:1; background:var(--muted); left:24%; top:3%; }
	.ball-five { width:9%; aspect-ratio:1; background:var(--orange); left:35%; bottom:5%; }
	@keyframes float { from { transform:translateY(-6px); } to { transform:translateY(6px); } }
	@media (max-width:700px) { .hero { grid-template-columns:1fr; gap:12px; position:relative; } .hero-copy { padding:24px 0; } h1 { font-size:clamp(3.1rem, 12vw, 5rem); } .recipe-balls { position:absolute; width:100px; height:100px; right:0; top:0; opacity:.8; } .hero-kicker { max-width:calc(100% - 90px); font-size:.65rem; } }
	@media (max-width:360px) { .actions { gap:14px; } p { font-size:.85rem; } }
	@media (prefers-reduced-motion:reduce) { .ball { animation:none; } .button { transition:none; } }
</style>

---
import Layout from '../../layouts/Layout.astro';
import RecipeList from '../../components/RecipeList.astro';
import { collectionIndex, recipeCatalog } from '../../lib/recipes';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<Layout title="菜谱目录 · Nico 的菜谱">
	<section class="directory shell">
		<div class="intro"><div class="eyebrow">THE INDEX <span>/</span> 菜谱目录</div><h1>想吃什么？</h1><p>从三种来处，找一道今天想做的菜。</p></div>
		<div class="count"><strong>{recipeCatalog.length}</strong><span>道菜谱</span></div>
		<div class="sections">{collectionIndex.map((collection, index) => <details class="collection" data-collection={collection.id}>
			<summary><span class="section-number">{String(index + 1).padStart(2, '0')}</span><span>{collection.title}</span><small>{collection.recipes.length}</small><span class="chevron" aria-hidden="true">⌄</span></summary>
			<div class="groups">{collection.categories.map((group) => group.category ? <details class="category" data-category={group.category.id}>
				<summary><span>{group.category.title}</span><small>{group.recipes.length}</small><span class="chevron" aria-hidden="true">⌄</span></summary>
				<RecipeList recipes={group.recipes} />
			</details> : <RecipeList recipes={group.recipes} />)}</div>
		</details>)}</div>
		<a class="back-home" href={base}>← 返回首页</a>
	</section>
</Layout>
<style>
	.directory { position:relative; padding:clamp(48px, 8vw, 90px) 0 40px; }
	.intro { max-width:620px; }
	.eyebrow { color:var(--orange); font-size:.74rem; letter-spacing:.12em; }
	.eyebrow span { color:var(--muted); margin:0 6px; }
	h1 { color:var(--moss); font-size:clamp(2.9rem, 7vw, 5rem); letter-spacing:-.08em; line-height:1.08; margin:20px 0 14px; font-weight:800; }
	.intro p { color:var(--muted); margin:0; }
	.count { position:absolute; top:clamp(58px, 9vw, 100px); right:0; display:flex; align-items:baseline; gap:9px; color:var(--muted); font-size:12px; }
	.count strong { color:var(--orange); font-size:2.1rem; font-weight:400; }
	.sections { margin-top:clamp(38px, 6vw, 64px); border-top:1px solid var(--line); }
	.collection { border-bottom:1px solid var(--line); }
	summary { min-height:74px; display:grid; grid-template-columns:50px minmax(0, 1fr) auto 24px; gap:12px; align-items:center; cursor:pointer; list-style:none; color:var(--moss); font-size:1.1rem; font-weight:800; padding:14px 0; line-height:1.5; overflow-wrap:anywhere; }
	summary::-webkit-details-marker { display:none; }
	summary:hover { color:var(--ink); }
	.section-number { color:var(--orange); font-size:12px; font-weight:400; }
	summary small { color:var(--muted); font-size:12px; font-weight:400; }
	.chevron { color:var(--orange); font-size:1.35rem; text-align:right; transition:transform .2s; }
	details[open] > summary > .chevron { transform:rotate(180deg); }
	.groups { padding-left:62px; }
	.category { border-top:1px solid var(--line); }
	.category > summary { grid-template-columns:minmax(0, 1fr) auto 24px; min-height:60px; font-size:.95rem; font-weight:400; }
	.back-home { display:inline-flex; align-items:center; min-height:44px; margin-top:26px; color:var(--moss); font-size:12px; text-decoration:none; }
	@media (max-width:600px) { .count { position:static; margin-top:20px; } summary { grid-template-columns:24px minmax(0, 1fr) auto 20px; gap:8px; font-size:1rem; } .groups { padding-left:32px; } }
	@media (prefers-reduced-motion:reduce) { .chevron { transition:none; } }
</style>

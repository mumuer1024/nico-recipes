---
import Layout from '../../layouts/Layout.astro';
import { recipes } from '../../lib/recipes';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
export function getStaticPaths() { return recipes.map((recipe) => ({ params: { slug: recipe.filePath.replace(/\.md$/i, '') }, props: { recipe } })); }
const { recipe } = Astro.props;
const { Content } = recipe.module;
---
<Layout title={`${recipe.title} · Nico 的菜谱`}>
	<article class="recipe shell">
		<a class="back" href={`${base}recipes/`}>← 菜谱目录</a>
		<header class="recipe-head"><div class="eyebrow">RECIPE NOTEBOOK</div><h1>{recipe.title}</h1><div class="path">{recipe.filePath}</div></header>
		<div class="markdown"><Content /></div>
		<a class="back bottom" href={`${base}recipes/`}>← 返回菜谱目录</a>
	</article>
</Layout>
<style>
	.recipe { max-width:850px; padding:52px 0 50px; }
	.back { color:var(--moss); font-size:12px; text-decoration:none; }
	.recipe-head { padding:68px 0 48px; border-bottom:1px solid var(--line); }
	.eyebrow { color:var(--orange); font-size:.74rem; font-weight:400; letter-spacing:.12em; }
	h1 { max-width:800px; margin:20px 0; color:var(--moss); font-size:clamp(2.35rem, 6vw, 4.8rem); line-height:1.1; letter-spacing:-.07em; font-weight:800; overflow-wrap:anywhere; }
	.path { color:var(--muted); font-size:12px; overflow-wrap:anywhere; }
	.markdown { padding:48px 0; max-width:720px; font-size:16px; line-height:1.78; }
	.markdown :global(h1) { display:none; }
	.markdown :global(h2) { margin:2.2em 0 .7em; color:var(--moss); font-size:1.28rem; line-height:1.4; letter-spacing:-.03em; font-weight:800; }
	.markdown :global(h3) { margin:1.8em 0 .6em; color:var(--moss); font-size:1.08rem; line-height:1.45; font-weight:800; }
	.markdown :global(p), .markdown :global(li) { overflow-wrap:anywhere; }
	.markdown :global(ul), .markdown :global(ol) { padding-left:1.35em; }
	.markdown :global(li)::marker { color:var(--orange); }
	.markdown :global(strong) { color:var(--moss); }
	.markdown :global(hr) { border:0; border-top:1px solid var(--line); margin:2.5em 0; }
	.markdown :global(a) { color:var(--orange); }
	.bottom { display:inline-block; border-top:1px solid var(--line); padding-top:25px; }
	@media (max-width:600px) { .recipe { padding-top:34px; } .recipe-head { padding:54px 0 34px; } .markdown { padding:32px 0; } }
</style>
